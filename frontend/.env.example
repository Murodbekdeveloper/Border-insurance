NEXT_PUBLIC_API_URL=http://localhost:4000

# Error monitoring (Sentry). Leave both empty to disable — no-op without a
# DSN. Usually the same DSN in both, just consumed at different points:
# NEXT_PUBLIC_SENTRY_DSN is inlined into the client bundle at build time,
# SENTRY_DSN is read at runtime for server-side (SSR/route handler) errors.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=osago
# Set to 'true' for managed Postgres providers (e.g. Render) whose external
# endpoint terminates TLS with a cert outside Node's default CA bundle.
# Leave unset for local/docker-compose Postgres.
DB_SSL=

JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Separate "iOS" type OAuth client (Google Cloud Console) for the mobile
# app's native iOS Google Sign-In. Leave empty to keep accepting only the
# web client's tokens.
GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple — no separate credential needed, just the app's Bundle ID.
APPLE_BUNDLE_ID=com.border.app

FRONTEND_URL=http://localhost:3000

# 'mock' (default) or 'payme'. Leave as mock until real Payme merchant
# credentials below are filled in.
PAYMENT_GATEWAY_PROVIDER=mock
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ENDPOINT=https://checkout.test.paycom.uz/api

# Left empty by default — falls back to logging the email/SMS instead of
# sending it, so notifications stay testable without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OSAGO Online <no-reply@osago.local>

# Google Cloud Vision REST API key — used to OCR tech-passport/driving-
# license photos in the mobile app's document upload screens. Leave empty
# to keep auto-detect disabled (fields stay manual-entry only).
GOOGLE_VISION_API_KEY=

# Partner sug'urta kompaniyasi (real OSAGO issuer, Asia Insurance) —
# outbound /save-policy etc. calls. Auth is HTTP Basic (login/password),
# per swagger.asia-insurance.uz/swagger-files/osago3.yaml.
INSURANCE_PARTNER_API_URL=https://ais.asia-insurance.uz
INSURANCE_PARTNER_LOGIN=
INSURANCE_PARTNER_PASSWORD=

# Inbound: token WE hand to the regulator/Asia Insurance so they can call
# GET /partner/transactions/:transactionId back to reconcile a policy
# (NAPP reglament, in force since 2026-07-01). Generate a real random
# value for production — never leave this at its dev default.
INSURANCE_PARTNER_INBOUND_TOKEN=dev_partner_token

# Separate static token WE generate for Asia Insurance's payall_url
# payment-completion callback (POST /partner/payment-callback). Generate a
# real random value for production — never leave this at its dev default.
INSURANCE_PARTNER_CALLBACK_TOKEN=dev_callback_token

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Separate secrets from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET above — admin
# tokens must never validate on customer endpoints or vice versa.
ADMIN_JWT_ACCESS_SECRET=change_me
ADMIN_JWT_ACCESS_EXPIRES_IN_SECONDS=900
ADMIN_JWT_REFRESH_SECRET=change_me_too
ADMIN_JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Error monitoring (Sentry). Leave empty to disable — no-op without a DSN.
SENTRY_DSN=
